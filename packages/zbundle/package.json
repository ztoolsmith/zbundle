{
  "name": "zbundle",
  "version": "0.1.1",
  "description": "A JavaScript/TypeScript bundler written in Zig, built on zcompiler — scope hoisting, tree-shaking, single file",
  "keywords": [
    "bundler",
    "zig",
    "javascript",
    "typescript",
    "esm",
    "module-graph"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "dist",
    "index.js",
    "index.d.ts",
    "bindings.js",
    "scripts"
  ],
  "scripts": {
    "build": "zignapi build && tsc",
    "build:zig": "zignapi build",
    "build:ts": "tsc",
    "test": "node --test",
    "prepublishOnly": "zignapi build && tsc"
  },
  "zignapi": {
    "binaryName": "zbundle",
    "packageName": "@zbundle/binding",
    "targets": [
      "darwin-arm64",
      "darwin-x64",
      "linux-x64-gnu",
      "linux-x64-musl",
      "linux-arm64-gnu",
      "win32-x64-msvc"
    ]
  },
  "devDependencies": {
    "zignapi": "0.4.1"
  },
  "license": "MIT",
  "bin": {
    "zbundle": "dist/cli.js"
  },
  "optionalDependencies": {
    "@zbundle/binding-darwin-arm64": "0.1.1",
    "@zbundle/binding-darwin-x64": "0.1.1",
    "@zbundle/binding-linux-arm64-gnu": "0.1.1",
    "@zbundle/binding-linux-x64-gnu": "0.1.1",
    "@zbundle/binding-linux-x64-musl": "0.1.1",
    "@zbundle/binding-win32-x64-msvc": "0.1.1"
  }
}
