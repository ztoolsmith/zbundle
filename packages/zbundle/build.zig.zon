.{
    .name = .zbundle,
    .version = "0.4.4",
    .fingerprint = 0xc1cdc345f538e502, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // BOTH sibling repositories (same convention as zcompiler -> zignapi).
        // `zcompiler` provides the `zcompiler` Zig module (parser + semantic +
        // AST); `zignapi` provides the `zignapi` module (the N-API bridge).
        .zignapi = .{ .path = "../../../zignapi/packages/zignapi" },
        .zcompiler = .{ .path = "../../../zcompiler/packages/zcompiler" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "native",
    },
}
